<%- layout("/layouts/boilerplate") -%>

    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3><%= listing.title %> </h3>
        </div>
        <div class="card col-6 offset-3">
            <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <%= listing.description %> <br>
                        &#8377;<%= listing.price.toLocaleString("en-IN") %> <br>
                            <%= listing.location %> <br>
                                <%= listing.country %>
                </p>
            </div>
        </div>
        <br>
        <div class="d-flex gap-2 my-1">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3">
                Edit
            </a>

            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-danger offset-4">
                    Delete
                </button>
            </form>
        </div>


        <div class="col-8 offset-3 my-3" >
            <hr>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="POST">
                <div>
                    <label for="comment" class="form-label">Comment</label>
                    <textarea id="comment" cols="30" rows="10" name="review[comment]" class="form-control"></textarea>
                </div>
                <div>
                    <label for="rating" class="form-label" >Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" placeholder="Add rating" class="form-range">
                </div>
                <br>
                <button class="btn btn-dark">Submit</button>
            </form>
        </div>
    </div>